# CPU-only Ollama. The default image is pinned in compose.yaml for VM 106 (amd64).
OLLAMA_COMPLETION_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_QUEUE=32
OLLAMA_CPU_LIMIT=4.0
OLLAMA_MEMORY_LIMIT=5500m
OLLAMA_INIT_CPU_LIMIT=1.0
OLLAMA_INIT_MEMORY_LIMIT=1g
